generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int       @id @default(autoincrement())
  name                    String    @db.VarChar(100)
  email                   String    @unique @db.VarChar(100)
  password                String?   @db.VarChar(255)
  role                    String?   @default("Customer") @db.VarChar(50)
  phone                   String?   @db.VarChar(50)
  address                 String?   @db.Text
  profileImage            String?   @map("profile_image") @db.Text
  notificationPreferences Json?     @default("{\"bookingUpdates\":true,\"quotationNotifications\":true,\"paymentReminders\":true,\"eventReminders\":true,\"systemAnnouncements\":true}") @map("notification_preferences")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  quotations Quotation[]
  bookings   Booking[]
  inquiries  Inquiry[]
  feedbacks  Feedback[]
  passwordResetTokens PasswordResetToken[]
  googleIdentities    GoogleIdentity[]

  @@map("users")
}

model EventType {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  services    Service[]
  packages    Package[]
  inquiries   Inquiry[]

  @@map("event_types")
}

model Service {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(150)
  category      String?   @db.VarChar(100)
  shortDesc     String?   @map("short_desc") @db.Text
  fullDesc      String?   @map("full_desc") @db.Text
  description   String?   @db.Text
  price         Decimal   @db.Decimal(10, 2)
  featuredImage String?   @map("featured_image") @db.Text
  iconName      String?   @default("Sparkles") @map("icon_name") @db.VarChar(50)
  features      Json?     @default("[]")
  inclusions    Json?     @default("[]")
  isActive      Boolean?  @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  bookingServices BookingService[]
  eventTypes      EventType[]

  @@map("services")
}

model Package {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(150)
  tagline          String?   @db.Text
  description      String?   @db.Text
  capacity         String?   @db.VarChar(100)
  price            Decimal   @db.Decimal(10, 2)
  originalPrice    Decimal?  @map("original_price") @db.Decimal(10, 2)
  isPopular        Boolean?  @default(false) @map("is_popular")
  isActive         Boolean?  @default(true) @map("is_active")
  idealFor         String?   @map("ideal_for") @db.Text
  inclusions       Json?     @default("[]")
  features         Json?     @default("[]")
  servicesIncluded Json?     @default("[]") @map("services_included")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  bookingPackages BookingPackage[]
  eventTypes      EventType[]

  @@map("packages")
}

model Inquiry {
  id               Int       @id @default(autoincrement())
  trackingId       String    @unique @map("tracking_id") @db.VarChar(50)
  userId           Int?      @map("user_id")
  clientName       String?   @map("client_name") @db.VarChar(100)
  clientEmail      String?   @map("client_email") @db.VarChar(100)
  clientPhone      String?   @map("client_phone") @db.VarChar(50)
  eventType        String    @map("event_type") @db.VarChar(100)
  eventDate        DateTime  @map("event_date") @db.Date
  eventVenue       String    @map("event_venue") @db.VarChar(255)
  guestsCount      Int       @map("guests_count")
  requirements     String?   @db.Text
  selectedServices Json?     @default("[]") @map("selected_services")
  packageId        String?   @map("package_id") @db.VarChar(50)
  notes            String?   @db.Text
  estimatedBudget  String?   @map("estimated_budget") @db.VarChar(50)
  status           String?   @default("Pending Review") @db.VarChar(50)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamp(6)
  cancelledBy      String?   @map("cancelled_by") @db.VarChar(100)
  cancellationReason String? @map("cancellation_reason") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  eventTypeId            Int?      @map("event_type_id")
  customEventDescription String?   @map("custom_event_description") @db.VarChar(100)

  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventTypeRef EventType?  @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  quotations   Quotation[]
  bookings     Booking[]

  @@map("inquiries")
}

model Quotation {
  id                  Int       @id @default(autoincrement())
  quotationRef        String    @unique @map("quotation_ref") @db.VarChar(50)
  inquiryId           Int?      @map("inquiry_id")
  userId              Int?      @map("user_id")
  clientName          String    @map("client_name") @db.VarChar(100)
  clientEmail         String    @map("client_email") @db.VarChar(100)
  clientPhone         String?   @map("client_phone") @db.VarChar(50)
  eventType           String    @map("event_type") @db.VarChar(100)
  eventDate           DateTime  @map("event_date") @db.Date
  venue               String    @db.VarChar(255)
  guestCount          Int       @map("guest_count")
  items               Json      @default("[]")
  subtotal            Decimal   @db.Decimal(12, 2)
  discounts           Json?     @default("[]")
  additionalCharges   Json?     @default("[]") @map("additional_charges")
  grandTotal          Decimal   @map("grand_total") @db.Decimal(12, 2)
  requiredDownpayment Decimal   @map("required_downpayment") @db.Decimal(12, 2)
  validUntil          DateTime  @map("valid_until") @db.Date
  validityDays        Int       @default(14) @map("validity_days")
  status              String    @default("Draft") @db.VarChar(50)
  adminComment        String?   @map("admin_comment") @db.Text
  notes               String?   @db.Text
  terms               Json?     @default("[]")
  sentAt              DateTime? @map("sent_at") @db.Timestamp(6)
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamp(6)
  depositPaidAt       DateTime? @map("deposit_paid_at") @db.Timestamp(6)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamp(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  inquiry  Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]
  payments PaymentTransaction[]

  @@map("quotations")
}

model Staff {
  id        Int       @id @default(autoincrement())
  staffCode String    @unique @map("staff_code") @db.VarChar(50)
  name      String    @db.VarChar(100)
  role      String    @db.VarChar(100)
  phone     String    @db.VarChar(50)
  email     String    @db.VarChar(100)
  status    String    @default("Available") @db.VarChar(50)
  skills    Json?     @default("[]")
  avatar    String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  bookingStaff BookingStaff[]

  @@map("staff")
}

model EquipmentResource {
  id                Int       @id @default(autoincrement())
  resourceCode      String    @unique @map("resource_code") @db.VarChar(50)
  name              String    @db.VarChar(150)
  category          String    @db.VarChar(100)
  quantity          Int       @default(1)
  unit              String    @default("units") @db.VarChar(50)
  condition         String    @default("Excellent") @db.VarChar(50)
  assignedServiceId String?   @map("assigned_service_id") @db.VarChar(50)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  bookingResources BookingResource[]

  @@map("equipment_resources")
}

model Booking {
  id                 Int       @id @default(autoincrement())
  bookingRef         String    @unique @map("booking_ref") @db.VarChar(50)
  userId             Int?      @map("user_id")
  inquiryId          Int?      @map("inquiry_id")
  quotationId        Int?      @map("quotation_id")
  clientName         String    @map("client_name") @db.VarChar(100)
  clientEmail        String    @map("client_email") @db.VarChar(100)
  clientPhone        String    @map("client_phone") @db.VarChar(50)
  eventTitle         String    @map("event_title") @db.VarChar(200)
  eventType          String    @map("event_type") @db.VarChar(100)
  eventDate          DateTime  @map("event_date") @db.Date
  startTime          String    @default("17:00") @map("start_time") @db.VarChar(10)
  endTime            String    @default("23:00") @map("end_time") @db.VarChar(10)
  venue              String    @db.VarChar(255)
  guestCount         Int       @map("guest_count")
  totalAmount        Decimal   @map("total_amount") @db.Decimal(12, 2)
  status             String    @default("Tentative") @db.VarChar(50)
  cancellationReason String?   @map("cancellation_reason") @db.Text
  rescheduledFrom    DateTime? @map("rescheduled_from") @db.Date
  notes              String?   @db.Text
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  inquiry          Inquiry?             @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  quotation        Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  schedule         EventSchedule?
  bookingServices  BookingService[]
  bookingPackages  BookingPackage[]
  bookingStaff     BookingStaff[]
  bookingResources BookingResource[]
  payments         PaymentTransaction[]
  feedback         Feedback?

  @@map("bookings")
}

model BookingService {
  id          Int     @id @default(autoincrement())
  bookingId   Int     @map("booking_id")
  serviceId   Int?    @map("service_id")
  serviceCode String? @map("service_code") @db.VarChar(50)
  name        String  @db.VarChar(150)
  price       Decimal @db.Decimal(10, 2)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("booking_services")
}

model BookingPackage {
  id          Int     @id @default(autoincrement())
  bookingId   Int     @map("booking_id")
  packageId   Int?    @map("package_id")
  packageCode String? @map("package_code") @db.VarChar(50)
  name        String  @db.VarChar(150)
  price       Decimal @db.Decimal(10, 2)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@map("booking_packages")
}

model BookingStaff {
  id        Int     @id @default(autoincrement())
  bookingId Int     @map("booking_id")
  staffId   Int     @map("staff_id")
  role      String? @db.VarChar(100)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("booking_staff")
}

model BookingResource {
  id         Int @id @default(autoincrement())
  bookingId  Int @map("booking_id")
  resourceId Int @map("resource_id")
  quantity   Int @default(1)

  booking  Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  resource EquipmentResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("booking_resources")
}

model EventSchedule {
  id        Int       @id @default(autoincrement())
  bookingId Int       @unique @map("booking_id")
  eventDate DateTime  @map("event_date") @db.Date
  startTime String    @default("17:00") @map("start_time") @db.VarChar(10)
  endTime   String    @default("23:00") @map("end_time") @db.VarChar(10)
  venue     String    @db.VarChar(255)
  status    String    @default("Active") @db.VarChar(50)
  timeline  Json?     @default("[]")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("event_schedules")
}

model PaymentTransaction {
  id              Int       @id @default(autoincrement())
  paymentRef      String    @unique @map("payment_ref") @db.VarChar(50)
  receiptNumber   String    @map("receipt_number") @db.VarChar(50)
  bookingId       Int?      @map("booking_id")
  quotationId     Int?      @map("quotation_id")
  clientName      String    @map("client_name") @db.VarChar(100)
  clientEmail     String    @map("client_email") @db.VarChar(100)
  type            String    @db.VarChar(100)
  amount          Decimal   @db.Decimal(12, 2)
  method          String    @db.VarChar(100)
  referenceNumber String    @map("reference_number") @db.VarChar(100)
  date            DateTime  @default(now()) @db.Date
  status          String    @default("Pending Verification") @db.VarChar(50)
  verified        Boolean   @default(false)
  verifiedBy      String?   @map("verified_by") @db.VarChar(100)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamp(6)
  rejectionReason String?   @map("rejection_reason") @db.Text
  rejectedBy      String?   @map("rejected_by") @db.VarChar(100)
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamp(6)
  proofUrl        String?   @map("proof_url") @db.Text
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  @@map("payment_transactions")
}

model Feedback {
  id              Int       @id @default(autoincrement())
  bookingId       Int       @unique @map("booking_id")
  userId          Int       @map("user_id")
  overallRating   Int       @map("overall_rating")
  serviceRating   Int       @map("service_rating")
  staffRating     Int       @map("staff_rating")
  executionRating Int       @map("execution_rating")
  comments        String?   @db.Text
  suggestions     String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model GoogleIdentity {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  googleId  String   @unique @map("google_id") @db.VarChar(255)
  email     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_identities")
}
