# Application Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Credentials
DATABASE_URL="postgresql://postgres:root@localhost:5432/jad_events_db?schema=public"
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jad_events_db

# Security
JWT_SECRET=secret123

# Email Service / SMTP Configuration
# When SMTP credentials are not specified, Nodemailer automatically creates a live
# Ethereal Email test account and generates an instant web preview link.
# To send actual production emails (e.g. Gmail / SendGrid / Amazon SES), uncomment and configure:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
# EMAIL_FROM=no-reply@jadevents.com
# EMAIL_FROM_NAME="JAD Events Support"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Gmail API Credentials for Server-Side Email Sending (Forgot Password)
GMAIL_CLIENT_ID="YOUR_GMAIL_OAUTH_CLIENT_ID"
GMAIL_CLIENT_SECRET="YOUR_GMAIL_OAUTH_CLIENT_SECRET"
GMAIL_SENDER_EMAIL="your-jad-events@gmail.com"
GMAIL_REFRESH_TOKEN="YOUR_GMAIL_REFRESH_TOKEN"
